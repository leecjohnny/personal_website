---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { articlePath } from '../lib/article-path';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 12);
---

<SiteLayout>
	<main class="home">
		<section class="home-intro" aria-labelledby="home-title">
			<h2 id="home-title">Hi! Welcome! I’m Johnny.</h2>
			<div class="intro-copy">
				<p>
					Building <a href="https://caisey.me">caisey.me</a>!
				</p>
				<p>
					Previously, at Adept (prev. computer use AI research lab
					{' '}<a href="https://www.cnbc.com/2024/06/28/amazon-hires-execs-from-ai-startup-adept-and-licenses-its-technology.html">exited</a>{' '}
					to Amazon),{' '}<a href="https://amazon.jobs/en/teams/lab126/">Amazon Lab126</a>,{' '}
					<a href="https://23andme.com/">23andMe</a>, and{' '}
					<a href="https://salesforce.com/">Salesforce</a>.
				</p>
			</div>
		</section>

		<section class="latest" id="latest" aria-labelledby="latest-title">
			<div class="section-heading">
				<h2 id="latest-title">Latest</h2>
			</div>
			<ul class="article-list">
				{
					posts.map((post) => (
						<li>
							<a class="post-card" href={articlePath(post.data.sourceUrl)}>
								<time
									class="post-date"
									datetime={post.data.pubDate.toISOString()}
								>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
							<h3 class="post-title">{post.data.title}</h3>
								<span class="post-arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</SiteLayout>
