---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { articlePath } from '../lib/article-path';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 12);
---

<SiteLayout>
	<main class="home">
		<section class="home-intro" aria-labelledby="home-title">
			<div>
				<p class="eyebrow">Johnny Lee</p>
				<h1 id="home-title">Hi!<br />Welcome.</h1>
			</div>
			<div class="intro-copy">
				<p>
					Building <a href="https://caisey.me">caisey.me</a>.
				</p>
				<p>
					Previously, at Adept (exited to Amazon), Amazon Lab126,
					23andMe, and Salesforce.
				</p>
				<p>
					Writing about technology, markets, intelligence, and the
					things that make the future feel close.
				</p>
			</div>
		</section>

		<section class="latest" id="latest" aria-labelledby="latest-title">
			<div class="section-heading">
				<h2 id="latest-title">Latest</h2>
				<a href="/blog/">View all articles →</a>
			</div>
			<ul class="article-list">
				{
					posts.map((post) => (
						<li>
							<a class="post-card" href={articlePath(post.data.sourceUrl)}>
								<time
									class="post-date"
									datetime={post.data.pubDate.toISOString()}
								>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
								<div>
									<h3 class="post-title">{post.data.title}</h3>
									{post.data.externalUrl && (
										<span class="post-external">Also published externally</span>
									)}
								</div>
								<span class="post-arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</SiteLayout>
