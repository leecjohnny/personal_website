{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "astro dev",
    "assets:generate": "bun scripts/generate-og-image.mjs",
    "assets:localize": "bun scripts/localize-remote-images.mjs",
    "build": "bun run assets:generate && astro build",
    "build:cloudflare": "PUBLIC_CLOUDFLARE_IMAGE_TRANSFORMS=true PUBLIC_CLOUDFLARE_IMAGE_HOST=https://johnnyclee.com bun run build",
    "audit:seo": "bun scripts/audit-seo.mjs",
    "audit:cloudflare": "bun scripts/audit-cloudflare.mjs",
    "deploy": "wrangler deploy",
    "deploy:cloudflare": "bun run build:cloudflare && bun run audit:cloudflare && wrangler deploy",
    "deploy:dry-run": "bun run build:cloudflare && bun run audit:cloudflare && wrangler deploy --dry-run",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "wrangler": "4.120.0"
  }
}
